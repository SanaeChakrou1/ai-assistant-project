    {
      "parameters": {
        "jsCode": "// Get the input data from webhook\nconst inputData = items[0].json;\n\n// Handle both direct properties and nested body\nconst chatInput = inputData.chatInput || inputData.body?.chatInput || \"\";\nconst imageBase64 = inputData.image || inputData.body?.image;\nconst userText = chatInput || \"Hello\";\n\n// Check if we have image data\nif (!imageBase64) {\n  return [{\n    json: {\n      chatInput: userText,\n      sessionId: inputData.sessionId || inputData.body?.sessionId || \"default\",\n      filePrompt: \"\" // Keep empty for text-only conversations\n    }\n  }];\n}\n\ntry {\n  // Convert Base64 to binary (remove data URL prefix if present)\n  const base64Data = imageBase64.replace(/^data:image\\/[a-z]+;base64,/, '');\n  const binaryData = Buffer.from(base64Data, 'base64');\n  \n  // Create the prompt for vision analysis\n  const prompt = `${userText}\\n\\nPlease analyze the provided image and give a detailed response.`;\n  \n  return [{\n    json: {\n      chatInput: prompt,\n      sessionId: inputData.sessionId || inputData.body?.sessionId || \"default\",\n      filePrompt: \"\",\n      hasImage: true\n    },\n    binary: {\n      data: {\n        data: binaryData,\n        mimeType: \"image/jpeg\",\n        fileName: \"uploaded_image.jpg\"\n      }\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      error: \"Failed to process image: \" + error.message,\n      chatInput: userText,\n      sessionId: inputData.sessionId || inputData.body?.sessionId || \"default\",\n      filePrompt: \"\"\n    }\n  }];\n}"
      },
